rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /system/{document=**} {
      allow read, write: if true;
    }
    match /app_data/{document=**} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
