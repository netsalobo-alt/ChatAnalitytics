{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access for ChatAnalytics",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Auth UID of the user"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "manager", "operator"],
          "description": "User access role"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "User account status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "AppData": {
      "title": "AppData",
      "description": "Persistent application state including integration settings, leads, and investments",
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last modification"
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered system users and their roles"
    },
    "/app_data/{docId}": {
      "schema": "AppData",
      "description": "Persistent application configuration, leads, and investments"
    },
    "/system/{docId}": {
      "schema": "AppData",
      "description": "System configuration and setup status"
    }
  }
}
